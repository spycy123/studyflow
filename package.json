{
  "name": "studyflow-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "StudyFlow - Academic Management & Productivity System",
  "workspaces": [
    "frontend",
    "backend",
    "qa"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test": "node --experimental-strip-types --test qa/tests/api/smoke.test.ts",
    "docker:up": "docker compose -f devops/docker-compose.yml up --build",
    "docker:down": "docker compose -f devops/docker-compose.yml down"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
